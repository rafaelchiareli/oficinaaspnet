@model IEnumerable<Paciente>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="page-header">
    <h1 class="page-title">Pacientes</h1>
    <a asp-action="Create" class="btn btn-primary">Novo paciente</a>
</div>

@if (TempData["MensagemSucesso"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<section class="content-panel" aria-label="Lista de pacientes">
    <form method="get" class="search-bar">
        <input name="nome" value="@ViewBag.NomePesquisado" class="form-control"
               aria-label="Nome do paciente" placeholder="Pesquisar por nome" />
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Pesquisar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Nome)</th>
                    <th>@Html.DisplayNameFor(m => m.Cpf)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefone)</th>
                    <th>@Html.DisplayNameFor(m => m.DataNascimento)</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Cpf</td>
                        <td>@item.Telefone</td>
                        <td>@item.DataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
