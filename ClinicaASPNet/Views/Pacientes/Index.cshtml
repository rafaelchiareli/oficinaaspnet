@model IEnumerable<Paciente>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Pacientes</h1>
    <a asp-action="Create" class="btn btn-primary">Novo Paciente</a>
    @{
        if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["MensagemSucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    }
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-8">
            <input name="nome" value="@ViewBag.NomePesquisado"
                   class="form-control" placeholder="Pesquisar pelo nome" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary">Pesquisar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpar</a>

        </div>
    </form>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Nome)</th>
                    <th>@Html.DisplayNameFor(m => m.Cpf)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefone)</th>
                    <th>@Html.DisplayNameFor(m => m.DataNascimento)</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.Cpf</td>
                            <td>@item.Telefone</td>
                            <td>@item.DataNascimento</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">Detalhes</a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
